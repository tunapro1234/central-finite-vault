[Unit]
Description=CFV: laptopta olmayan foto/videoların depo4 ikinci kopyası
Documentation=file:///srv/central-finite-vault/src/photos/icloud/ikinci-kopya.sh
RequiresMountsFor=/mnt/depo1 /mnt/depo4

[Service]
# bp msg hedefi server-cfv ve altı (cfv-photos) ile sınırlı; imza [service:<birim>]
Environment=BP_OWNER=server-cfv
Type=oneshot
ExecStart=/srv/central-finite-vault/src/photos/icloud/ikinci-kopya.sh
Nice=15
IOSchedulingClass=idle
