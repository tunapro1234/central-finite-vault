[Unit]
Description=CFV: hafif tur (sabah / zepp-cloud / tarti ham verisi değiştiyse yalnız onları içe al; değişmediyse hemen çıkar)
Documentation=file:///srv/cfv/prod/src/akis/hafif.py
RequiresMountsFor=/mnt/depo1

[Service]
# Kod yalnız commit'lenmiş prod worktree'den (cfv-gunluk gibi). Gece turu koşarken / borg penceresinde hiçbir şey yapmaz.
WorkingDirectory=/srv/cfv/prod
Environment=CFV_DATA=/mnt/depo1/cfv/data
Type=oneshot
UMask=0077
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=BP_OWNER=server-cfv
Environment=CFV_WORKERS=4
ExecStart=/root/.local/bin/uv run --quiet --directory /srv/cfv/prod python -m akis.hafif
Nice=19
IOSchedulingClass=idle
CPUWeight=20
TimeoutStartSec=45min
