# cfv-site — SUNUCU sistem birimi. Kurulum: ln -s <bu dosya> /etc/systemd/system/ && systemctl enable --now cfv-site
# src/systemd/ altına konmadı: oradaki install.sh laptop --user birimlerini cfv-* glob'uyla bağlıyor.
# Kod src/site/cfv_site (pyproject dışı; başlatıcı src/site/cfv-site PYTHONPATH'i ayarlar).
#
# ŞU AN YALNIZ SENTETİK VERİ (Tuna, 2026-11-09): CFV_SITE_REQUIRE_SYNTHETIC=1 → DB'de meta.synthetic=1
# yoksa servis açılmaz / veri dönmez. Gerçek veriye geçmek AYRI KARAR, Tuna onayı ister.
[Unit]
Description=CFV site: zaman çizgisi + kişi ağı (127.0.0.1:3050, SENTETİK veri)
After=network.target

[Service]
WorkingDirectory=/srv/central-finite-vault
Environment=CFV_SITE_HOST=127.0.0.1 CFV_SITE_PORT=3050
Environment=CFV_DATA=/srv/cfv/site/mock-data
Environment=CFV_SITE_REQUIRE_SYNTHETIC=1
ExecStart=/srv/central-finite-vault/src/site/cfv-site serve
Restart=on-failure
RestartSec=3
# şifre hash'i + oturumlar: /var/lib/cfv-site (700)
StateDirectory=cfv-site
StateDirectoryMode=0700
UMask=0077
# Disk salt-okur; yazılabilen yalnız kararlar ve küçük resim önbelleği.
ProtectSystem=strict
ReadWritePaths=/srv/cfv/site/mock-data/config /srv/cfv/site/mock-data/processed/site-thumbs
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
